---
import Live2DChat from "./Live2DChat.astro";

const expressions = [
	{ label: "开心", icon: "🎵", group: "Note", index: 1 },
	{ label: "委屈", icon: "🥺", group: "Note", index: 0 },
	{ label: "庆祝", icon: "🌈", group: "SectionClear", index: 0 },
	{ label: "得意", icon: "🌼", group: "Song", index: 2 },
	{ label: "沮丧", icon: "🌧️", group: "Song", index: 0 },
	{ label: "恢复待机", icon: "↺", group: "Idle", index: 0 },
];
---

<Live2DChat />

<div
	id="live2d-expressions"
	popover="auto"
	role="dialog"
	aria-labelledby="live2d-expressions-title"
>
	<div class="expression-header">
		<strong id="live2d-expressions-title">表情</strong>
		<button type="button" id="live2d-expressions-close" aria-label="关闭表情菜单">×</button>
	</div>
	<p id="live2d-expression-status" role="status">模型加载中…</p>
	<div class="expression-grid">
		{expressions.map((expression) => (
			<button
				type="button"
				class="expression-option"
				data-label={expression.label}
				data-motion-group={expression.group}
				data-motion-index={expression.index}
				aria-pressed={expression.label === "恢复待机" ? "true" : "false"}
				disabled
			>
				<span aria-hidden="true">{expression.icon}</span>
				{expression.label}
			</button>
		))}
	</div>
</div>

<style>
	#live2d-expressions {
		position: fixed;
		inset: auto;
		margin: 0;
		width: 16rem;
		max-width: calc(100vw - 1.5rem);
		max-height: calc(100dvh - 1.5rem);
		overflow-y: auto;
		padding: 0.875rem;
		border: 1px solid var(--line-color);
		border-radius: 1rem;
		background: var(--float-panel-bg);
		color: var(--btn-content);
		box-shadow: 0 12px 36px rgb(0 0 0 / 18%);
	}
	.expression-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.expression-header button {
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 50%;
		font-size: 1.25rem;
	}
	#live2d-expression-status {
		margin: 0.25rem 0 0.75rem;
		font-size: 0.75rem;
	}
	.expression-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.375rem;
	}
	.expression-option {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem;
		border-radius: 0.625rem;
		font-size: 0.875rem;
		text-align: left;
		transition: background-color 0.15s;
	}
	.expression-option[aria-pressed="true"] {
		background: var(--btn-regular-bg);
	}
	button:enabled:hover {
		background: var(--btn-regular-bg-hover);
	}
	button:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	button:disabled {
		cursor: wait;
		opacity: 0.5;
	}
	:global(.live2d-controls:focus-within) {
		opacity: 1 !important;
		pointer-events: auto !important;
	}
</style>

<script>
import { createWidget } from "l2d-widget";

// Skip on small screens where the widget would cover content
if (window.matchMedia("(min-width: 1024px)").matches) {
	const panel = document.getElementById("live2d-expressions")!;
	const status = document.getElementById("live2d-expression-status")!;
	const closeButton = document.getElementById("live2d-expressions-close")!;
	const options = Array.from(panel.querySelectorAll<HTMLButtonElement>(".expression-option"));
	const idleButton = options.find((button) => button.dataset.label === "恢复待机")!;
	let ready = false;

	const widget = createWidget({
		model: {
			path: "/live2d/roro/roro.model3.json",
			scale: 1.5,
			offset: [-0.1, -0.45],
			tips: false,
		},
		position: "bottom-left",
		size: {
			width: 280,
			height: 400,
		},
		menus: {
			items: [
				{
					icon: "mdi:bed",
					label: "休眠",
					onClick(widget) {
						window.dispatchEvent(new CustomEvent("live2d:sleep"));
						widget.sleep();
					},
				},
				{
					icon: "mdi:emoticon-outline",
					label: "表情",
					onClick() {
						if (panel.togglePopover()) {
							positionPanel();
							const selected = options.find((button) => !button.disabled && button.getAttribute("aria-pressed") === "true");
							(selected ?? closeButton).focus({ preventScroll: true });
						}
					},
				},
				{
					icon: "mdi:chat-outline",
					label: "聊天",
					onClick() {
						window.dispatchEvent(new CustomEvent("live2d:chat-toggle"));
					},
				},
				{
					icon: "mdi:console",
					label: "终端",
					// The terminal owns itself and only listens for this event, so
					// the mascot never has to reach into it.
					onClick() {
						window.dispatchEvent(new CustomEvent("terminal:open"));
					},
				},
				{
					icon: "mdi:information-outline",
					label: "About",
					onClick() {
						window.open("https://github.com/hacxy/oh-my-live2d", "_blank", "noopener");
					},
				},
			],
		},
	});

	const controls = widget.l2d.getCanvas().parentElement;
	widget.l2d.getCanvas().dataset.live2dCanvas = "true";
	const trigger = controls?.querySelector<HTMLButtonElement>('button[title="表情"]');
	trigger?.setAttribute("aria-label", "表情");
	trigger?.setAttribute("aria-haspopup", "dialog");
	trigger?.setAttribute("aria-controls", panel.id);
	trigger?.setAttribute("aria-expanded", "false");
	trigger?.parentElement?.classList.add("live2d-controls");
	const chatTrigger = controls?.querySelector<HTMLButtonElement>('button[title="聊天"]');
	chatTrigger?.setAttribute("aria-label", "聊天");
	chatTrigger?.setAttribute("aria-haspopup", "dialog");
	chatTrigger?.setAttribute("aria-controls", "live2d-chat");
	chatTrigger?.setAttribute("aria-expanded", "false");

	const emotionMotions: Record<string, [string, number]> = {
		idle: ["Idle", 0],
		happy: ["Note", 1],
		sad: ["Note", 0],
		celebrate: ["SectionClear", 0],
		proud: ["Song", 2],
		down: ["Song", 0],
	};
	window.addEventListener("live2d:emotion", (event) => {
		if (!ready || !(event instanceof CustomEvent) || typeof event.detail !== "string") return;
		const [group, index] = Object.hasOwn(emotionMotions, event.detail) ? emotionMotions[event.detail] : emotionMotions.idle;
		const selected = options.find((button) => button.dataset.motionGroup === group && Number(button.dataset.motionIndex) === index);
		if (selected) selectOption(selected);
		widget.l2d.playMotion(group, index, 3);
	});

	function positionPanel() {
		const anchor = (trigger ?? widget.l2d.getCanvas()).getBoundingClientRect();
		const gap = 12;
		let left = anchor.right + gap;
		if (left + panel.offsetWidth > window.innerWidth - gap) {
			left = anchor.left - panel.offsetWidth - gap;
		}
		panel.style.left = `${Math.max(gap, Math.min(left, window.innerWidth - panel.offsetWidth - gap))}px`;
		const top = anchor.top + anchor.height / 2 - panel.offsetHeight / 2;
		panel.style.top = `${Math.max(gap, Math.min(top, window.innerHeight - panel.offsetHeight - gap))}px`;
	}

	function selectOption(selected: HTMLButtonElement) {
		for (const button of options) {
			button.setAttribute("aria-pressed", String(button === selected));
		}
		status.textContent = `当前：${selected === idleButton ? "待机" : selected.dataset.label}`;
	}

	widget.l2d.on("loaded", () => {
		ready = true;
		widget.l2d.getCanvas().dataset.live2dReady = "true";
		for (const button of options) button.disabled = false;
		selectOption(idleButton);
		window.dispatchEvent(new CustomEvent("live2d:ready"));
	});
	widget.l2d.on("motionstart", (group: string) => {
		if (ready && group === "Idle") selectOption(idleButton);
	});

	for (const button of options) {
		button.addEventListener("click", () => {
			if (!ready) return;
			selectOption(button);
			// Force priority lets a new choice interrupt an unfinished motion.
			widget.l2d.playMotion(button.dataset.motionGroup!, Number(button.dataset.motionIndex), 3);
		});
	}

	function closePanel() {
		panel.hidePopover();
		trigger?.focus({ preventScroll: true });
	}
	closeButton.addEventListener("click", closePanel);
	panel.addEventListener("keydown", (event) => {
		if (event.key === "Escape") {
			event.preventDefault();
			closePanel();
		}
	});
	panel.addEventListener("toggle", () => {
		trigger?.setAttribute("aria-expanded", String(panel.matches(":popover-open")));
	});
	window.addEventListener("resize", () => {
		if (panel.matches(":popover-open")) positionPanel();
	});
}
</script>
