---
import type { MarkdownHeading } from "astro";
import { midiPlayerConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import Calendar from "./Calendar.svelte";
import MidiPlayer from "./MidiPlayer.svelte";
import Profile from "./Profile.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <!-- Below lg the sidebar stops being a column and stacks under the content,
         where these would stretch to full width — so they are phone/tablet-hidden. -->
    <div id="sidebar-sticky" class="transition-all duration-700 hidden lg:flex flex-col w-full gap-4 top-4 sticky top-4">
        <WidgetLayout name={i18n(I18nKey.calendar)} id="calendar" class="onload-animation" style="animation-delay: 150ms">
            <div class="min-h-[14rem]">
                <Calendar client:only="svelte"></Calendar>
            </div>
        </WidgetLayout>
        {midiPlayerConfig.enable &&
            <WidgetLayout name={i18n(I18nKey.music)} id="midi-player" class="onload-animation" style="animation-delay: 200ms">
                <div class="min-h-[5.5rem]">
                    <MidiPlayer client:only="svelte"></MidiPlayer>
                </div>
            </WidgetLayout>
        }
    </div>
</div>
