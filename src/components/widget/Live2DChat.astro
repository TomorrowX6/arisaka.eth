---
import { live2dChatConfig } from "../../config/live2d-chat";
---

<section
	id="live2d-chat"
	popover="manual"
	role="dialog"
	aria-label="与 Roro 聊天"
	data-pagefind-ignore
	data-endpoint={live2dChatConfig.endpoint}
	data-auto-topics={String(live2dChatConfig.autoTopics)}
	data-rotation-interval-ms={live2dChatConfig.rotationIntervalMs}
>
	<button id="live2d-chat-close" class="close-button" type="button" aria-label="关闭聊天">×</button>
	<div id="live2d-chat-messages" role="log" aria-live="polite" aria-relevant="additions text" aria-label="聊天记录">
		<p class="chat-message" data-role="model">主人，Roro 来陪你啦 (｡･ω･｡)</p>
	</div>
	<form id="live2d-chat-form">
		<label class="sr-only" for="live2d-chat-input">发给 Roro 的消息</label>
		<div class="chat-composer">
			<textarea id="live2d-chat-input" rows="3" maxlength="1000" placeholder="主人，想和 Roro 聊些什么呢？" autocomplete="off"></textarea>
			<button id="live2d-chat-send" type="submit" disabled aria-label="发送消息">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 19V5m-7 7 7-7 7 7" />
				</svg>
			</button>
		</div>
	</form>
</section>

<button id="live2d-speech" type="button" aria-label="打开与 Roro 的聊天" data-pagefind-ignore hidden>
	<span id="live2d-speech-text" aria-live="polite">主人，Roro 来陪你啦 (｡･ω･｡)</span>
</button>

<style>
	#live2d-chat {
		position: fixed;
		inset: auto;
		margin: 0;
		width: 24rem;
		max-width: calc(100vw - 1.5rem);
		max-height: calc(100dvh - 1.5rem);
		padding: 2rem 1rem 1rem;
		overflow-y: auto;
		border: 1px solid #22c55e;
		border-radius: 1rem;
		background: var(--page-bg);
		color: var(--btn-content);
		box-shadow: 0 12px 36px rgb(34 197 94 / 20%);
	}
	.chat-composer {
		position: relative;
	}
	.close-button {
		position: absolute;
		top: 0.375rem;
		right: 0.5rem;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		font-size: 1.25rem;
		line-height: 1;
	}
	#live2d-chat-messages {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		height: min(15rem, 32dvh);
		min-height: 6rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.25rem 0.25rem 0.75rem;
	}
	:global(#live2d-chat .chat-message) {
		align-self: flex-start;
		flex-shrink: 0;
		width: fit-content;
		max-width: 92%;
		margin: 0;
		padding: 0.625rem 0.75rem;
		border-radius: 0.75rem 0.75rem 0.75rem 0.125rem;
		background: color-mix(in srgb, #22c55e 12%, var(--btn-regular-bg));
		font-size: 0.8125rem;
		line-height: 1.7;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	:global(#live2d-chat .chat-message[data-role="user"]) {
		align-self: flex-end;
		border-radius: 0.75rem 0.75rem 0.125rem 0.75rem;
		background: var(--btn-regular-bg-hover);
	}
	#live2d-chat-input {
		display: block;
		width: 100%;
		min-height: 4.5rem;
		max-height: 9rem;
		resize: vertical;
		padding: 0.625rem 3rem 0.75rem 0.75rem;
		border: 1px solid var(--line-color);
		border-radius: 0.75rem;
		background: var(--page-bg);
		font: inherit;
		font-size: 0.8125rem;
	}
	#live2d-chat-send {
		position: absolute;
		right: 0.5rem;
		bottom: 0.5rem;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		padding: 0;
		border-radius: 50%;
		background: #16a34a;
		color: #fff;
		transition: background-color 150ms, opacity 150ms;
	}
	#live2d-chat-send svg { width: 1rem; height: 1rem; }
	#live2d-chat-send:enabled:hover { background: #15803d; }
	#live2d-chat-send[data-busy="true"] svg { display: none; }
	#live2d-chat-send[data-busy="true"]::after {
		content: "";
		width: 0.875rem;
		height: 0.875rem;
		border: 2px solid rgb(255 255 255 / 40%);
		border-top-color: currentColor;
		border-radius: 50%;
		animation: send-pending 800ms linear infinite;
	}
	@keyframes send-pending { to { transform: rotate(360deg); } }
	@media (prefers-reduced-motion: reduce) {
		#live2d-chat-send { transition: none; }
		#live2d-chat-send[data-busy="true"]::after { animation: none; }
	}
	button:enabled:hover { background: var(--btn-regular-bg-hover); }
	button:disabled { opacity: 0.45; cursor: not-allowed; }
	button:focus-visible, textarea:focus-visible { outline: 2px solid #22c55e; outline-offset: 2px; }
	#live2d-chat, #live2d-chat-messages, #live2d-chat-input, #live2d-speech-text {
		scrollbar-width: thin;
		scrollbar-color: rgb(34 197 94 / 55%) transparent;
	}
	#live2d-chat-messages, #live2d-chat-input, #live2d-speech-text {
		scrollbar-gutter: stable;
	}
	#live2d-chat::-webkit-scrollbar, #live2d-chat-messages::-webkit-scrollbar,
	#live2d-chat-input::-webkit-scrollbar, #live2d-speech-text::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	#live2d-chat::-webkit-scrollbar-track, #live2d-chat-messages::-webkit-scrollbar-track,
	#live2d-chat-input::-webkit-scrollbar-track, #live2d-speech-text::-webkit-scrollbar-track {
		background: transparent;
	}
	#live2d-chat::-webkit-scrollbar-thumb, #live2d-chat-messages::-webkit-scrollbar-thumb,
	#live2d-chat-input::-webkit-scrollbar-thumb, #live2d-speech-text::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: rgb(34 197 94 / 55%);
	}
	#live2d-chat::-webkit-scrollbar-thumb:hover, #live2d-chat-messages::-webkit-scrollbar-thumb:hover,
	#live2d-chat-input::-webkit-scrollbar-thumb:hover, #live2d-speech-text::-webkit-scrollbar-thumb:hover {
		background: rgb(34 197 94 / 80%);
	}
	#live2d-chat::-webkit-scrollbar-button, #live2d-chat-messages::-webkit-scrollbar-button,
	#live2d-chat-input::-webkit-scrollbar-button, #live2d-speech-text::-webkit-scrollbar-button {
		display: none;
	}
	#live2d-speech {
		position: fixed;
		z-index: 10000;
		box-sizing: border-box;
		width: max-content;
		max-width: min(21rem, calc(100vw - 1.5rem));
		padding: 0.75rem;
		border: 1px solid #22c55e;
		border-radius: 1.25rem;
		background: var(--page-bg);
		color: var(--btn-content);
		box-shadow: 0 6px 24px rgb(34 197 94 / 20%);
		text-align: left;
	}
	#live2d-speech[hidden] { display: none; }
	#live2d-speech::after {
		content: "";
		position: absolute;
		left: var(--speech-tail, 50%);
		bottom: -7px;
		width: 12px;
		height: 12px;
		background: inherit;
		border-right: 1px solid #22c55e;
		border-bottom: 1px solid #22c55e;
		transform: translateX(-50%) rotate(45deg);
	}
	#live2d-speech-text {
		display: block;
		max-height: min(20rem, max(3rem, calc(var(--speech-max-height, 45dvh) - 1.5rem - 2px)));
		overflow-y: auto;
		overscroll-behavior: contain;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		font-size: 0.8125rem;
		line-height: 1.8;
	}
</style>

<script>
import "../../scripts/live2d-chat";
</script>
