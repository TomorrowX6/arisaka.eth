---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { commentConfig, siteConfig } from "../config";

// Waline ships a smaller set of locales than the theme does
const WALINE_LANGS: Record<string, string> = {
	zh_cn: "zh-CN",
	zh_tw: "zh-TW",
	ja: "jp",
};
const lang = WALINE_LANGS[siteConfig.lang.toLowerCase()] ?? "en";
---
<div class="card-base px-6 md:px-9 py-6 mb-4 onload-animation">
    <div class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-4 mb-4
        before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
        before:absolute before:left-[-16px] before:top-[5.5px]">
        {i18n(I18nKey.comments)}
    </div>
    <div id="waline" data-server-url={commentConfig.serverURL} data-lang={lang}></div>
</div>

<style is:global>
    #waline {
        --waline-font-size: 0.875rem;
        --waline-theme-color: var(--primary);
        --waline-active-color: var(--primary);
        --waline-color: rgba(0, 0, 0, 0.75);
        --waline-light-grey: rgba(0, 0, 0, 0.5);
        --waline-dark-grey: rgba(0, 0, 0, 0.5);
        --waline-bg-color: transparent;
        --waline-bg-color-light: var(--btn-regular-bg);
        --waline-bg-color-hover: var(--btn-regular-bg-hover);
        --waline-disable-bg-color: var(--btn-regular-bg);
        --waline-disable-color: rgba(0, 0, 0, 0.3);
        --waline-border-color: var(--line-divider);
        --waline-border: 1px solid var(--line-divider);
        --waline-code-bg-color: var(--codeblock-bg);
        --waline-info-bg-color: var(--btn-regular-bg);
        --waline-info-color: rgba(0, 0, 0, 0.5);
        --waline-bq-color: var(--btn-regular-bg);
        --waline-badge-color: var(--primary);
        --waline-avatar-radius: 0.5rem;
        --waline-box-shadow: none;
    }

    html.dark #waline {
        --waline-color: rgba(255, 255, 255, 0.75);
        --waline-light-grey: rgba(255, 255, 255, 0.5);
        --waline-dark-grey: rgba(255, 255, 255, 0.5);
        --waline-disable-color: rgba(255, 255, 255, 0.3);
        --waline-info-color: rgba(255, 255, 255, 0.5);
    }

    /* match the rounded controls used everywhere else in the theme */
    #waline .wl-btn,
    #waline .wl-editor,
    #waline .wl-input,
    #waline .wl-panel {
        border-radius: 0.5rem;
    }
</style>

<script>
// Imported as a URL rather than a side-effect so the stylesheet is not tied to
// the document head Astro builds: Swup swaps the head on every visit, and in dev
// the styles are injected by Vite, both of which can leave Waline unstyled.
// Owning the <link> ourselves means we can guarantee it is applied before mount.
import walineStyleUrl from "@waline/client/style?url";

type WalineInstance = { el: HTMLElement | null; destroy: () => void };

const STYLE_ID = "waline-style";

function ensureStyles(): Promise<void> {
	const existing = document.getElementById(STYLE_ID) as HTMLLinkElement | null;
	if (existing?.sheet) return Promise.resolve();

	const link = existing ?? document.createElement("link");
	if (!existing) {
		link.id = STYLE_ID;
		link.rel = "stylesheet";
		link.href = walineStyleUrl;
		document.head.appendChild(link);
	}

	return new Promise((resolve) => {
		const done = () => resolve();
		link.addEventListener("load", done, { once: true });
		link.addEventListener("error", done, { once: true });
		// never block the comments on a stylesheet that refuses to settle
		setTimeout(done, 3000);
	});
}

let waline: WalineInstance | null = null;
let mounting = false;

/**
 * Swup has usually already thrown away the old comment DOM by the time we get
 * here, which makes Waline's own teardown throw while removing its nodes. That
 * exception used to escape setup() and skip the code that mounts the section
 * again, so the comments went missing on a random subset of visits.
 */
function destroyWaline() {
	try {
		waline?.destroy();
	} catch {
		// the instance is unusable either way
	}
	waline = null;
}

async function mount(el: HTMLElement) {
	mounting = true;
	try {
		const [{ init }] = await Promise.all([
			import("@waline/client/full"),
			ensureStyles(),
		]);

		// the visit may have moved on while the bundle loaded
		if (!el.isConnected || el.children.length > 0) return;

		destroyWaline();
		waline = init({
			el,
			serverURL: el.dataset.serverUrl as string,
			lang: el.dataset.lang,
			dark: "html.dark",
			path: window.location.pathname,
			// the card already has a "Comments" heading — keep only the count
			locale: { comment: "" },
		});
	} finally {
		mounting = false;
		// A visit that landed while the bundle was loading was ignored because
		// `mounting` was set. Only retry for a genuinely different node, so a
		// mount that fails to render cannot loop.
		const current = document.getElementById("waline");
		if (current && current !== el) setup();
	}
}

/**
 * Idempotent and driven purely by what is in the DOM rather than by bookkeeping
 * across visits — Swup fires several hooks per visit and may hand back cached
 * nodes, so any "have I seen this one before" state ends up wrong eventually.
 * An empty #waline means there is work to do; anything else means there isn't.
 *
 * Mounting is deliberately not deferred until the section scrolls into view:
 * OverlayScrollbars rebuilds the body scroller on every visit, which made both
 * IntersectionObserver and scroll listeners miss visits at random. Correctness
 * beats saving the bundle for readers who never scroll down.
 */
function setup() {
	const el = document.getElementById("waline");
	if (!el) {
		destroyWaline();
		return;
	}
	if (mounting || el.children.length > 0) return;
	void mount(el);
}

setup();

/**
 * Swup swaps the page content without reloading, so the section has to be
 * mounted again on every visit. The hooks can fire while the outgoing markup is
 * still in the document, so the actual work waits for the frame after the swap.
 * setup() is idempotent, which makes running it from both hooks harmless.
 */
function scheduleSetup() {
	requestAnimationFrame(() => requestAnimationFrame(setup));
}

function listenToSwup() {
	window.swup.hooks.on("content:replace", scheduleSetup);
	window.swup.hooks.on("page:view", scheduleSetup);
}
if (window?.swup?.hooks) {
	listenToSwup();
} else {
	document.addEventListener("swup:enable", listenToSwup);
}
</script>
