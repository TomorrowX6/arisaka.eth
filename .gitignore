# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env*
!.env.example

# Arweave wallet keyfile — never commit
wallet.json

# incremental deploy state (content hash -> arweave txid)
.deploy-cache.json

# NOTE: .permaweb-cache.json is deliberately committed. It maps file content
# hashes to Arweave transaction IDs so unchanged files are never re-uploaded or
# re-paid for. GitHub Actions caches expire after 7 days idle, which for an
# occasionally-updated blog means every deploy would pay full price; keeping the
# map in git makes it permanent and shared between local and CI runs. It holds
# no secrets — those transaction IDs are already public on chain.

# permaweb deploy secrets — never commit
.env.permaweb

# macOS-specific files
.DS_Store

.vercel

package-lock.json
bun.lockb
yarn.lock

# ide
.idea
*.iml

# Local session histories may contain credentials and must never be published.
rollout-*.jsonl
SOURCE-MANIFEST.sha256
SOURCE-PACKAGE.md

# Cloudflare local state and secrets
.wrangler/
.dev.vars*
!.dev.vars.example
