{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "arisaka-desktop-apps",
  "account_id": "7e91b0eadb038a578d12d625c9ed006b",
  "main": "worker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "DESKTOP_ORIGIN": "https://arisaka-afterglow.454565615.workers.dev" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "env": {
    "local": {
      "name": "arisaka-desktop-apps-local",
      "vars": { "DESKTOP_ORIGIN": "http://127.0.0.1:*" }
    }
  }
}
