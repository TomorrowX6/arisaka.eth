{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arisaka-afterglow",
  "account_id": "7e91b0eadb038a578d12d625c9ed006b",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "secrets": { "required": ["SESSION_SECRET"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_SESSIONS", "class_name": "GameSession" }]
  },
  "exports": {
    "GameSession": { "type": "durable-object", "storage": "sqlite" }
  },
  "env": {
    "local": {
      "name": "arisaka-afterglow-local",
      "secrets": { "required": ["SESSION_SECRET"] },
      "durable_objects": {
        "bindings": [{ "name": "GAME_SESSIONS", "class_name": "GameSession" }]
      }
    }
  }
}
