{
  "name": "arisaka-afterglow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "generate": "node scripts/build-challenges.mjs",
    "dev": "pnpm generate && node scripts/setup-local.mjs && wrangler dev --env local --port 8788",
    "types": "wrangler types && node scripts/runtime-types.mjs",
    "check": "pnpm generate && pnpm types && tsc --noEmit",
    "test": "pnpm generate && node --test --test-concurrency=1 test/puzzles.test.mjs test/expert.test.mjs test/toolkit.test.mjs test/deployment.test.mjs test/recovery.test.mjs test/runtimes.test.mjs test/runtime-deployment.test.mjs && vitest run",
    "test:browser": "node scripts/test-browser.mjs test/browser.test.mjs",
    "test:campaign": "node scripts/test-browser.mjs test/campaign.test.mjs",
    "test:e2e": "node scripts/test-browser.mjs",
    "test:all": "pnpm test && pnpm test:e2e",
    "build": "pnpm generate && wrangler deploy --env \"\" --dry-run --outdir dist",
    "deploy": "node scripts/deploy.mjs",
    "runtimes:prepare": "node scripts/build-runtimes.mjs",
    "runtimes:dev": "pnpm runtimes:prepare && wrangler dev --config runtime/wrangler.jsonc --env local --port 8789",
    "runtimes:build": "pnpm runtimes:prepare && wrangler deploy --config runtime/wrangler.jsonc --env \"\" --dry-run",
    "runtimes:deploy": "node scripts/deploy-runtimes.mjs",
    "test:runtimes": "node scripts/test-runtimes.mjs",
    "startup": "wrangler check startup --outfile .private/startup.cpuprofile"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.9",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@noble/hashes": "1.8.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fflate": "0.8.2",
    "jsqr": "1.4.0",
    "miniflare": "5.20260911.1-alpha",
    "openpgp": "6.3.1",
    "pdfjs-dist": "6.3.289",
    "pyodide": "314.0.7",
    "qrcode": "1.5.4",
    "sql.js": "1.14.2",
    "typescript": "5.9.3",
    "vitest": "~4.1.0",
    "wabt": "1.0.39",
    "wrangler": "4.131.2"
  },
  "packageManager": "pnpm@9.14.4"
}
